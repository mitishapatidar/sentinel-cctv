# SENTINEL AI ANPR Pipeline Environment Configuration
# Copy this file to .env or place in root .env

# Supabase Cloud Database (PostgreSQL + Realtime)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Live CCTV Streaming Gateway Relay
CCTV_GATEWAY_EMAIL=your-gateway-registered-email@example.com
CCTV_GATEWAY_PASSWORD=your-gateway-access-password-here
RELAY_BASE_URL=http://127.0.0.1:8000
